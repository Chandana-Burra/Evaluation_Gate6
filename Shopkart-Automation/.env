PORT=8080
DB_HOST=localhost
DB_PORT=5000
DB_NAME=shopkart
DB_USER=postgres
DB_PASSWORD=Chandu@2003
DB_CONNECTION_TIMEOUT_MS=10000

# CI Testcontainers may set DATABASE_URL instead of the separate DB_* values.
DATABASE_URL=postgresql://postgres:Chandu%402003@localhost:5000/shopkart

# Use unique training-only values. Never commit the populated .env file.
SHOPKART_TOKEN_SECRET=replace-with-at-least-32-random-characters
SHOPKART_ALICE_PASSWORD=alice@shopkart.test
SHOPKART_BOB_PASSWORD=bob@shopkart.test
SHOPKART_CAROL_PASSWORD=carol@shopkart.test

# Optional UI/API failure delay used only for trainer demonstrations.
SHOPKART_API_DELAY_MS=0
